# atrium-llm-enrich — the published environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Do not commit `.env` (it is gitignored at .gitignore:151
# — keep it that way; this is the one repo whose contract includes an API key).
#
# This file is the COMPLETE ledger: every variable the api image's own
# configuration surface reads, with the default that is in the CODE. The curated
# partner-facing subset is the table in the hub's docs/k8s_deployment.md.
#
# ── Read this before assuming an entry works ─────────────────────────────────
# Nothing here loads a .env file. No module imports python-dotenv, and
# docker-compose.yaml has no `env_file:`. Compose reads `.env` ONLY to expand
# ${VAR} inside docker-compose.yaml itself, so a variable reaches the container
# only if the `llm-enrich-api` service's `environment:` block passes it through.
#
# This repo has the BEST passthrough of the five — eight variables, including the
# whole backend-selection set — and was, until now, the only one with no template
# at all. Tags:
#
#   [compose + k8s]  passed through by docker-compose.yaml's llm-enrich-api
#                    service, and settable in the k8s manifest's env: block.
#   [k8s / -e only]  NOT passed by docker-compose today — setting it in .env
#                    does nothing. Set it in the k8s manifest's env: block, or
#                    with `docker run -e VAR=...`. atrium-project#60 step 4 adds
#                    the missing passthroughs; until then this tag is the truth.
#
# ── A variable deliberately absent ───────────────────────────────────────────
# LOG_LEVEL is read by service/api.py:532 and is NOT listed here. It is withheld
# across all five repos until atrium-project#61 is verified green everywhere: in
# page-classification the same read is inert (a library module calls
# logging.basicConfig at import, and the entrypoint's own call has no
# force=True), and publishing a knob that works in four images and silently does
# nothing in the fifth is the defect atrium-project#58 was raised to stop.

# ── Backend selection ─────────────────────────────────────────────────────────
# [compose + k8s] Which LLM backend the service loads: `openrouter` (a hosted API,
# needs a key) or `ollama` (a self-hosted server, needs a reachable host). This
# choice decides which of the two blocks below you must fill in; the other is
# ignored entirely.
LLM_BACKEND=openrouter
# [k8s / -e only] Config file read for any value not supplied by the environment.
# The environment always wins. Relative to the working directory.
LLM_CONFIG=llm_config.txt

# ── OpenRouter backend (only when LLM_BACKEND=openrouter) ─────────────────────
# ⚠️ SECRET. Never commit a real value — not to this file, not to .env. In
# Kubernetes do NOT put it in the manifest's env: block as a literal either: use
# a Secret and a secretKeyRef. The reference manifest ships no Secret today, which
# is why llm-enrich cannot be deployed from it unmodified (atrium-project#60).
# [compose + k8s] Required — service/api.py:128-131 raises at startup without it.
OPENROUTER_API_KEY=
# [compose + k8s] Required — service/api.py:129-134 raises at startup without it.
# An OpenRouter model id, e.g. openai/gpt-4o-mini.
OPENROUTER_MODEL=
# [k8s / -e only] Optional attribution headers OpenRouter shows on your dashboard.
# Neither affects behaviour.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=atrium-llm-enrich

# ── Ollama backend (only when LLM_BACKEND=ollama) ─────────────────────────────
# [compose + k8s] Ollama server URL. ⚠️ The CODE default is http://localhost:11434,
# which is wrong INSIDE a container — it points at the container's own loopback,
# where no Ollama runs. docker-compose.yaml supplies http://host.docker.internal:11434,
# which is the correct value for a host-run Ollama and applies ONLY under compose.
# In Kubernetes, set this explicitly to the Ollama Service's DNS name; leaving it
# unset gives you the broken code default, not the working compose one.
OLLAMA_HOST=http://localhost:11434
# [compose + k8s] Required for this backend — service/api.py:150 raises without it.
# An Ollama model tag, e.g. llama3.1:8b.
OLLAMA_MODEL=

# ── LLM call tuning (both backends) ───────────────────────────────────────────
# [k8s / -e only] Per-call read timeout in seconds. Raise it for long documents or
# a slow self-hosted model — a cut-off call costs the whole enrichment.
LLM_TIMEOUT=300
# [k8s / -e only] Retries on a failed call.
LLM_MAX_RETRIES=3
# [k8s / -e only] Context window in tokens, used to size the input budget. Falls
# back to CONTEXT_WINDOW in llm_config.txt, then 32000. This is an ALGORITHMIC
# parameter, not deployment config: set it to match the model you selected above,
# not to tune throughput.
LLM_CONTEXT_WINDOW=32000
# [k8s / -e only] Archaeological vocabulary JSON. Falls back to VOCAB_PATH in
# llm_config.txt, then data_samples/vocab/union_nested.json. Algorithmic, not
# deployment config — listed for completeness, absent from the partner table.
VOCAB_PATH=data_samples/vocab/union_nested.json

# ── Image / provenance ────────────────────────────────────────────────────────
# Read by no Python — docker-compose.yaml interpolates these into the image tag
# and the build args. [compose only, by construction]
# Image tag used by docker-compose (matches para_config.txt [tool] on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref
ATRIUM_RUNNER_REF=dev

# ── HTTP surface ──────────────────────────────────────────────────────────────
# [compose + k8s] Port the api service binds, and the port service/healthcheck.py
# probes inside the container. In Kubernetes, change `containerPort` in the same
# edit. (atrium-project#58)
PORT=8000
# [k8s / -e only] Bind address. Leave at 0.0.0.0. service/healthcheck.py always
# probes 127.0.0.1 by design and never reads HOST, so 127.0.0.1 here gives a
# container that reports HEALTHY to every probe while being unreachable from
# outside it. This is the one value whose failure mode is silent.
HOST=0.0.0.0
# [compose + k8s] CSV of CORS origins. The CODE default is `*` — wide open —
# because service/atrium_service.py:370 falls back to it when unset. This repo's
# compose default is also `*`, unlike alto-postprocess's and page-classification's
# narrower localhost lists. Set it explicitly for any real deployment.
ALLOWED_ORIGINS=*
# [compose + k8s] Canonical upload limit in megabytes. 10 is THIS repo's built-in
# (service/api.py:46, `resolve_max_upload_mb(10)`); the five services do not share
# one value — alto 25, llm-enrich 10, nlp-enrich 5, page-classification 10,
# translator 50. This is the only repo whose compose file passes it through.
MAX_UPLOAD_MB=10
# DEPRECATED — do not set. A byte-valued fallback kept working for one release for
# callers that already exported it (strategy §4.5); MAX_UPLOAD_MB wins whenever
# both are present (service/atrium_service.py:353-364). Listed commented-out so
# the contract is complete and the deprecation is discoverable.
# MAX_UPLOAD_BYTES=
# [k8s / -e only] Path the container's own HEALTHCHECK probes. Change it only
# alongside the route itself.
HEALTHCHECK_PATH=/health

# ── Lifecycle ─────────────────────────────────────────────────────────────────
# [k8s / -e only] Seconds uvicorn waits for in-flight requests after SIGTERM.
# llm-enrich calls the model per line inside the request, so a single request can
# legitimately run for minutes — this is one of the two services most likely to
# need a raise. Raise it together with the deployment's grace period
# (terminationGracePeriodSeconds in k8s, see docs/k8s_deployment.md in the hub).
GRACEFUL_SHUTDOWN_S=20
# [k8s / -e only] Filesystem auto-reload. Development only — never in a
# deployment. Deliberately NOT wired into any compose or k8s template.
RELOAD=false

LOG_LEVEL=INFO
