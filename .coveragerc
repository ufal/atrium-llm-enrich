# .coveragerc
[run]
source = .
omit =
    tests/*
    *paradata.py
    para_licenses.py
    setup.py

[report]
# Ratchet: set ~2 points below the measured fast-lane baseline of 63.55%
# (2026-08-06, issue atrium-project#10 Phase 6). Raised from 42 — the suites grew
# substantially in the 08-05/06 round, and a floor left far below the real number
# stops being a ratchet: coverage can fall by twenty points and still pass.
fail_under = 61
exclude_lines =
    pragma: no cover
    def __repr__
    if self\.debug
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.: